<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.mythoriadesktop.AiChatAssistantController" styleClass="chat-root">
    <top>
        <VBox spacing="6" BorderPane.alignment="CENTER_LEFT">
            <Label text="AI Chat Assistant" styleClass="profile-title" />
            <Label text="Ask about Mythoria features, wallet, security, roles, or fantasy writing." styleClass="profile-subtitle" wrapText="true" />
            <Label fx:id="chatStatusLabel" text="Ready" styleClass="oracle-status" />
            <padding>
                <Insets top="0" right="0" bottom="14" left="0" />
            </padding>
        </VBox>
    </top>

    <center>
        <ListView fx:id="conversationList" styleClass="chat-list" />
    </center>

    <bottom>
        <HBox spacing="10" BorderPane.alignment="CENTER">
            <TextField fx:id="messageField" promptText="Write your message..." onAction="#onSendMessage" HBox.hgrow="ALWAYS" />
            <Button fx:id="sendButton" text="Send" onAction="#onSendMessage" styleClass="login-button" />
            <Button fx:id="clearButton" text="Clear" onAction="#onClearChat" />
            <padding>
                <Insets top="14" right="0" bottom="0" left="0" />
            </padding>
        </HBox>
    </bottom>

    <padding>
        <Insets top="22" right="22" bottom="22" left="22" />
    </padding>
</BorderPane>
