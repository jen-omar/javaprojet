<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.mythoriadesktop.IdentityVerificationController" spacing="18" styleClass="profile-panel" maxWidth="980">
    <HBox alignment="CENTER_LEFT" spacing="18">
        <VBox spacing="6">
            <Label text="Identity Verification" styleClass="profile-title" />
            <Label text="Upload a CIN or passport image and verify identity with Google Cloud Vision OCR." styleClass="profile-subtitle" wrapText="true" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Back to Profile" onAction="#onBack" />
    </HBox>

    <GridPane hgap="16" vgap="14" styleClass="profile-form">
        <columnConstraints>
            <ColumnConstraints percentWidth="35" />
            <ColumnConstraints percentWidth="65" hgrow="ALWAYS" />
        </columnConstraints>

        <Label text="Document Type" styleClass="login-field-label" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <ComboBox fx:id="documentTypeComboBox" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="1.7976931348623157E308" />

        <Label text="Selected Image" styleClass="login-field-label" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <TextField fx:id="selectedFileField" editable="false" HBox.hgrow="ALWAYS" promptText="No image selected" />
            <Button text="Select Image" onAction="#onSelectImage" />
        </HBox>

        <Label text="Verified" styleClass="login-field-label" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <Label fx:id="verificationStatusLabel" text="false" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Readable" styleClass="login-field-label" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <Label fx:id="readableValueLabel" text="false" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="Full Name" styleClass="login-field-label" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <Label fx:id="fullNameValueLabel" text="--" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <Label text="Birth Date" styleClass="login-field-label" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <Label fx:id="birthDateValueLabel" text="--" GridPane.columnIndex="1" GridPane.rowIndex="5" />

        <Label text="Document Number" styleClass="login-field-label" GridPane.columnIndex="0" GridPane.rowIndex="6" />
        <Label fx:id="documentNumberValueLabel" text="--" GridPane.columnIndex="1" GridPane.rowIndex="6" />
    </GridPane>

    <VBox spacing="8">
        <Label text="Extracted Text" styleClass="login-field-label" />
        <TextArea fx:id="extractedTextArea" editable="false" wrapText="true" prefRowCount="12" />
    </VBox>

    <HBox spacing="12">
        <Button text="Verify Identity" onAction="#onVerifyIdentity" styleClass="login-button" />
    </HBox>

    <Label fx:id="identityMessageLabel" text="" wrapText="true" />

    <padding>
        <Insets top="28" right="28" bottom="28" left="28" />
    </padding>
</VBox>
