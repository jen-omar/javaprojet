<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="620.0" prefWidth="820.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.mythoria.controller.FormLocalController"
            style="-fx-background-color: linear-gradient(to bottom right, #0f0f10, #1c1c1f);">

    <children>
        <VBox layoutX="80.0" layoutY="30.0"
              prefWidth="660.0" prefHeight="550.0"
              spacing="16.0"
              style="-fx-background-color: linear-gradient(to bottom, #1f1f22, #2c2c31);
                     -fx-background-radius: 20;
                     -fx-border-color: #a8a8a8;
                     -fx-border-width: 1.2;
                     -fx-border-radius: 20;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 18, 0.2, 0, 6);
                     -fx-padding: 25;">

            <children>

                <Label fx:id="titleLabel"
                       text="Ajouter un Local"
                       style="-fx-text-fill: linear-gradient(to right, #d9d9d9, #ffffff);
                              -fx-font-weight: bold;">
                    <font>
                        <Font name="System Bold" size="24.0"/>
                    </font>
                </Label>

                <Label text="Veuillez remplir les informations du local"
                       style="-fx-text-fill: #b8b8b8; -fx-font-size: 13px;" />

                <Label text="Nom"
                       style="-fx-text-fill: #d0d0d0; -fx-font-weight: bold;" />
                <TextField fx:id="tfName"
                           promptText="Nom du local"
                           style="-fx-background-color: #151518;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #8e8e8e;
                                  -fx-background-radius: 10;
                                  -fx-border-color: #8f8f8f;
                                  -fx-border-radius: 10;
                                  -fx-border-width: 1;" />

                <Label text="Description"
                       style="-fx-text-fill: #d0d0d0; -fx-font-weight: bold;" />
                <TextArea fx:id="taDescription"
                          promptText="Description du local"
                          prefHeight="90.0"
                          wrapText="true"
                          style="-fx-background-color: #151518;
                                 -fx-control-inner-background: #151518;
                                 -fx-text-fill: white;
                                 -fx-prompt-text-fill: #8e8e8e;
                                 -fx-background-radius: 10;
                                 -fx-border-color: #8f8f8f;
                                 -fx-border-radius: 10;
                                 -fx-border-width: 1;" />

                <Label text="Prix"
                       style="-fx-text-fill: #d0d0d0; -fx-font-weight: bold;" />
                <TextField fx:id="tfPrice"
                           promptText="Prix"
                           style="-fx-background-color: #151518;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #8e8e8e;
                                  -fx-background-radius: 10;
                                  -fx-border-color: #8f8f8f;
                                  -fx-border-radius: 10;
                                  -fx-border-width: 1;" />

                <Label text="Adresse"
                       style="-fx-text-fill: #d0d0d0; -fx-font-weight: bold;" />
                <TextField fx:id="tfAddress"
                           promptText="Adresse"
                           style="-fx-background-color: #151518;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #8e8e8e;
                                  -fx-background-radius: 10;
                                  -fx-border-color: #8f8f8f;
                                  -fx-border-radius: 10;
                                  -fx-border-width: 1;" />

                <Label text="Capacité"
                       style="-fx-text-fill: #d0d0d0; -fx-font-weight: bold;" />
                <TextField fx:id="tfCapacity"
                           promptText="Capacité"
                           style="-fx-background-color: #151518;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #8e8e8e;
                                  -fx-background-radius: 10;
                                  -fx-border-color: #8f8f8f;
                                  -fx-border-radius: 10;
                                  -fx-border-width: 1;" />

                <Label text="Image"
                       style="-fx-text-fill: #d0d0d0; -fx-font-weight: bold;" />
                <TextField fx:id="tfImage"
                           promptText="Nom ou chemin image"
                           style="-fx-background-color: #151518;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #8e8e8e;
                                  -fx-background-radius: 10;
                                  -fx-border-color: #8f8f8f;
                                  -fx-border-radius: 10;
                                  -fx-border-width: 1;" />

                <Label text="Statut"
                       style="-fx-text-fill: #d0d0d0; -fx-font-weight: bold;" />
                <ComboBox fx:id="cbStatus"
                          prefWidth="610.0"
                          style="-fx-background-color: #151518;
                                 -fx-text-fill: white;
                                 -fx-background-radius: 10;
                                 -fx-border-color: #8f8f8f;
                                 -fx-border-radius: 10;
                                 -fx-border-width: 1;" />

                <HBox spacing="20.0" style="-fx-alignment: center; -fx-padding: 15 0 0 0;">
                    <children>
                        <Button fx:id="btnSave"
                                text="Enregistrer"
                                onAction="#saveLocal"
                                prefWidth="140.0"
                                prefHeight="40.0"
                                style="-fx-background-color: linear-gradient(to bottom, #c0c0c0, #8e8e8e);
                                       -fx-text-fill: black;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 12;
                                       -fx-cursor: hand;" />

                        <Button text="Retour"
                                onAction="#retourListe"
                                prefWidth="140.0"
                                prefHeight="40.0"
                                style="-fx-background-color: linear-gradient(to bottom, #4a4a4a, #2c2c2c);
                                       -fx-text-fill: #e6e6e6;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 12;
                                       -fx-cursor: hand;
                                       -fx-border-color: #9e9e9e;
                                       -fx-border-radius: 12;
                                       -fx-border-width: 1;" />
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>