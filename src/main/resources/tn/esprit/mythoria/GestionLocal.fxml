<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="620.0" prefWidth="1080.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.mythoria.controller.GestionLocalController"
            style="-fx-background-color: transparent;">

   <children>
      <HBox layoutX="36.0" layoutY="24.0"
            prefHeight="560.0" prefWidth="1008.0"
            spacing="18.0"
            style="-fx-background-color: linear-gradient(to bottom, #1f1f22, #2c2c31);
                   -fx-background-radius: 24;
                   -fx-border-color: #a8a8a8;
                   -fx-border-width: 1.2;
                   -fx-border-radius: 24;
                   -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 18, 0.2, 0, 6);
                   -fx-padding: 18;">

         <children>
            <VBox prefWidth="180.0" spacing="12.0"
                  style="-fx-background-color: rgba(15,15,17,0.62);
                         -fx-background-radius: 18;
                         -fx-border-color: #5e6268;
                         -fx-border-radius: 18;
                         -fx-padding: 16;">
               <children>
                  <Label text="Locaux"
                         style="-fx-text-fill: #f3f5f7; -fx-font-size: 18px; -fx-font-weight: bold;" />
                  <Label text="Gestion admin des espaces"
                         wrapText="true"
                         style="-fx-text-fill: #b8b8b8; -fx-font-size: 12px;" />

                  <Button text="Ajouter"
                          mnemonicParsing="false"
                          onAction="#gotoAjouter"
                          prefHeight="40.0"
                          maxWidth="1.7976931348623157E308"
                          style="-fx-background-color: linear-gradient(to bottom, #c0c0c0, #8e8e8e);
                                 -fx-text-fill: black;
                                 -fx-font-size: 13px;
                                 -fx-font-weight: bold;
                                 -fx-background-radius: 10;
                                 -fx-cursor: hand;" />

                  <Button text="Modifier"
                          mnemonicParsing="false"
                          onAction="#gotoModifier"
                          prefHeight="40.0"
                          maxWidth="1.7976931348623157E308"
                          style="-fx-background-color: linear-gradient(to bottom, #9d9d9d, #6e6e6e);
                                 -fx-text-fill: white;
                                 -fx-font-size: 13px;
                                 -fx-font-weight: bold;
                                 -fx-background-radius: 10;
                                 -fx-cursor: hand;" />

                  <Button text="Supprimer"
                          mnemonicParsing="false"
                          onAction="#supprimerLocal"
                          prefHeight="40.0"
                          maxWidth="1.7976931348623157E308"
                          style="-fx-background-color: linear-gradient(to bottom, #4a4a4a, #2c2c2c);
                                 -fx-text-fill: #e6e6e6;
                                 -fx-font-size: 13px;
                                 -fx-font-weight: bold;
                                 -fx-background-radius: 10;
                                 -fx-cursor: hand;
                                 -fx-border-color: #9e9e9e;
                                 -fx-border-radius: 10;
                                 -fx-border-width: 1;" />

                  <Button text="Export Excel"
                          mnemonicParsing="false"
                          onAction="#exportLocauxExcel"
                          prefHeight="40.0"
                          maxWidth="1.7976931348623157E308"
                          style="-fx-background-color: linear-gradient(to bottom, #8fb9a8, #5f8d7a);
                                 -fx-text-fill: white;
                                 -fx-font-size: 13px;
                                 -fx-font-weight: bold;
                                 -fx-background-radius: 10;
                                 -fx-cursor: hand;" />
               </children>
            </VBox>

            <VBox prefHeight="524.0" prefWidth="770.0" spacing="18.0" style="-fx-padding: 8 8 8 4;">
               <children>
                  <Label text="Gestion des Locaux"
                         style="-fx-text-fill: linear-gradient(to right, #d9d9d9, #ffffff);
                                -fx-font-weight: bold;">
                     <font>
                        <Font name="System Bold" size="24.0"/>
                     </font>
                  </Label>

                  <Label text="Chaque local affiche maintenant son image, ses informations clefs et son statut."
                         wrapText="true"
                         style="-fx-text-fill: #b8b8b8; -fx-font-size: 13px;" />

                  <HBox spacing="12.0" style="-fx-alignment: center-left;">
                     <children>
                        <TextField fx:id="txtSearch"
                                   promptText="Rechercher un local (nom, adresse, statut...)"
                                   prefWidth="520.0"
                                   style="-fx-background-color: #151518;
                                          -fx-text-fill: white;
                                          -fx-prompt-text-fill: #8f8f8f;
                                          -fx-border-color: #8f8f8f;
                                          -fx-border-radius: 10;
                                          -fx-background-radius: 10;" />

                        <ComboBox fx:id="cbSort"
                                  promptText="Trier par"
                                  prefWidth="210.0"
                                  style="-fx-background-color: #151518;
                                         -fx-text-fill: white;
                                         -fx-border-color: #8f8f8f;
                                         -fx-border-radius: 10;
                                         -fx-background-radius: 10;" />
                     </children>
                  </HBox>

                  <ListView fx:id="lvlocals"
                            prefHeight="395.0"
                            prefWidth="750.0"
                            style="-fx-background-color: #151518;
                                   -fx-control-inner-background: #151518;
                                   -fx-background-insets: 0;
                                   -fx-background-radius: 18;
                                   -fx-border-color: #8f8f8f;
                                   -fx-border-radius: 18;
                                   -fx-border-width: 1;
                                   -fx-padding: 10;" />
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</AnchorPane>
