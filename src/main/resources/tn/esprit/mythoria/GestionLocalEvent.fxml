<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="660.0" prefWidth="1080.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.mythoria.controller.GestionLocalEventController"
            style="-fx-background-color: linear-gradient(to bottom right, #0f0f10, #1c1c1f);">

    <children>
        <VBox layoutX="50.0" layoutY="24.0"
              prefHeight="600.0" prefWidth="980.0"
              spacing="18.0"
              style="-fx-background-color: linear-gradient(to bottom, #1f1f22, #2c2c31);
                     -fx-background-radius: 24;
                     -fx-border-color: #a8a8a8;
                     -fx-border-width: 1.2;
                     -fx-border-radius: 24;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 18, 0.2, 0, 6);
                     -fx-padding: 24;">

            <children>
                <Label text="Gestion des Events par Local"
                       style="-fx-text-fill: linear-gradient(to right, #d9d9d9, #ffffff);
                              -fx-font-weight: bold;">
                    <font>
                        <Font name="System Bold" size="24.0"/>
                    </font>
                </Label>

                <Label text="Parcourez les locaux, puis ajoutez un event ou consultez les events lies depuis chaque carte."
                       wrapText="true"
                       style="-fx-text-fill: #b8b8b8; -fx-font-size: 13px;" />

                <HBox spacing="12.0" style="-fx-alignment: center-left;">
                    <children>
                        <TextField fx:id="txtSearch"
                                   promptText="Rechercher un local (nom, adresse, statut...)"
                                   prefWidth="560.0"
                                   style="-fx-background-color: #151518;
                                          -fx-text-fill: white;
                                          -fx-prompt-text-fill: #8f8f8f;
                                          -fx-border-color: #8f8f8f;
                                          -fx-border-radius: 10;
                                          -fx-background-radius: 10;" />

                        <ComboBox fx:id="cbSort"
                                  promptText="Trier par"
                                  prefWidth="220.0"
                                  style="-fx-background-color: #151518;
                                         -fx-text-fill: white;
                                         -fx-border-color: #8f8f8f;
                                         -fx-border-radius: 10;
                                         -fx-background-radius: 10;" />

                        <Button text="Maps"
                                onAction="#openLocalsMap"
                                prefHeight="36.0"
                                prefWidth="120.0"
                                style="-fx-background-color: linear-gradient(to bottom, #c0c0c0, #8e8e8e);
                                       -fx-text-fill: black;
                                       -fx-font-size: 13px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 10;
                                       -fx-cursor: hand;" />
                    </children>
                </HBox>

                <ScrollPane fx:id="localsScrollPane"
                            fitToWidth="true"
                            hbarPolicy="NEVER"
                            prefHeight="460.0"
                            prefWidth="930.0"
                            style="-fx-background-color: #151518;
                                   -fx-background: #151518;
                                   -fx-background-insets: 0;
                                   -fx-background-radius: 18;
                                   -fx-border-color: #8f8f8f;
                                   -fx-border-radius: 18;
                                   -fx-border-width: 1;
                                   -fx-padding: 10;">
                    <content>
                        <TilePane fx:id="localsTilePane"
                                  hgap="12.0"
                                  prefColumns="3"
                                  prefTileWidth="270.0"
                                  tileAlignment="TOP_LEFT"
                                  vgap="12.0"
                                  style="-fx-background-color: transparent; -fx-padding: 4;" />
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</AnchorPane>
