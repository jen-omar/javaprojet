<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="820.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.mythoria.controller.ListeEventsController"
            style="-fx-background-color: linear-gradient(to bottom right, #0f0f10, #1c1c1f);">

    <children>
        <VBox layoutX="70.0" layoutY="30.0"
              prefHeight="430.0" prefWidth="680.0"
              spacing="20.0"
              style="-fx-background-color: linear-gradient(to bottom, #1f1f22, #2c2c31);
                     -fx-background-radius: 20;
                     -fx-border-color: #a8a8a8;
                     -fx-border-width: 1.2;
                     -fx-border-radius: 20;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 18, 0.2, 0, 6);
                     -fx-padding: 20;">

            <children>
                <Label fx:id="lblTitre"
                       text="Liste des Events"
                       style="-fx-text-fill: linear-gradient(to right, #d9d9d9, #ffffff);
                              -fx-font-weight: bold;">
                    <font>
                        <Font name="System Bold" size="24.0"/>
                    </font>
                </Label>

                <Label text="Events du local sélectionné pour l'utilisateur 1"
                       style="-fx-text-fill: #b8b8b8; -fx-font-size: 13px;" />

                <ListView fx:id="lvEvents"
                          prefHeight="310.0"
                          prefWidth="640.0"
                          style="-fx-background-color: #151518;
                                 -fx-control-inner-background: #151518;
                                 -fx-background-insets: 0;
                                 -fx-background-radius: 14;
                                 -fx-border-color: #8f8f8f;
                                 -fx-border-radius: 14;
                                 -fx-border-width: 1;
                                 -fx-text-fill: white;
                                 -fx-padding: 8;" />

                <HBox spacing="18.0" style="-fx-alignment: center;">
                    <children>
                        <Button text="Modifier"
                                onAction="#gotoModifierEvent"
                                prefHeight="40.0"
                                prefWidth="130.0"
                                style="-fx-background-color: linear-gradient(to bottom, #c0c0c0, #8e8e8e);
                                       -fx-text-fill: black;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 12;
                                       -fx-cursor: hand;" />

                        <Button text="Supprimer"
                                onAction="#supprimerEvent"
                                prefHeight="40.0"
                                prefWidth="130.0"
                                style="-fx-background-color: linear-gradient(to bottom, #4a4a4a, #2c2c2c);
                                       -fx-text-fill: #e6e6e6;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 12;
                                       -fx-cursor: hand;
                                       -fx-border-color: #9e9e9e;
                                       -fx-border-radius: 12;
                                       -fx-border-width: 1;" />

                        <Button text="Retour"
                                onAction="#retourGestionLocalEvent"
                                prefHeight="40.0"
                                prefWidth="130.0"
                                style="-fx-background-color: linear-gradient(to bottom, #9d9d9d, #6e6e6e);
                                       -fx-text-fill: white;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 12;
                                       -fx-cursor: hand;" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>