<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1080.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.mythoria.controller.ListeEventsController"
            style="-fx-background-color: transparent;">

    <children>
        <HBox layoutX="36.0" layoutY="24.0"
              prefHeight="640.0" prefWidth="1008.0"
              spacing="18.0"
              style="-fx-background-color: linear-gradient(to bottom, #1f1f22, #2c2c31);
                     -fx-background-radius: 24;
                     -fx-border-color: #a8a8a8;
                     -fx-border-width: 1.2;
                     -fx-border-radius: 24;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 18, 0.2, 0, 6);
                     -fx-padding: 18;">

            <children>
                <VBox prefWidth="180.0" spacing="12.0"
                      style="-fx-background-color: rgba(15,15,17,0.62);
                             -fx-background-radius: 18;
                             -fx-border-color: #5e6268;
                             -fx-border-radius: 18;
                             -fx-padding: 16;">
                    <children>
                        <Label text="Actions"
                               style="-fx-text-fill: #f3f5f7; -fx-font-size: 18px; -fx-font-weight: bold;" />
                        <Label text="Gerer les events du local selectionne."
                               wrapText="true"
                               style="-fx-text-fill: #b8b8b8; -fx-font-size: 12px;" />

                        <Button text="Modifier"
                                onAction="#gotoModifierEvent"
                                prefHeight="40.0"
                                maxWidth="1.7976931348623157E308"
                                style="-fx-background-color: linear-gradient(to bottom, #c0c0c0, #8e8e8e);
                                       -fx-text-fill: black;
                                       -fx-font-size: 13px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 10;
                                       -fx-cursor: hand;" />

                        <Button text="Supprimer"
                                onAction="#supprimerEvent"
                                prefHeight="40.0"
                                maxWidth="1.7976931348623157E308"
                                style="-fx-background-color: linear-gradient(to bottom, #4a4a4a, #2c2c2c);
                                       -fx-text-fill: #e6e6e6;
                                       -fx-font-size: 13px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 10;
                                       -fx-cursor: hand;
                                       -fx-border-color: #9e9e9e;
                                       -fx-border-radius: 10;
                                       -fx-border-width: 1;" />

                        <Button text="Retour"
                                onAction="#retourGestionLocalEvent"
                                prefHeight="40.0"
                                maxWidth="1.7976931348623157E308"
                                style="-fx-background-color: linear-gradient(to bottom, #9d9d9d, #6e6e6e);
                                       -fx-text-fill: white;
                                       -fx-font-size: 13px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 10;
                                       -fx-cursor: hand;" />
                    </children>
                </VBox>

                <VBox prefHeight="604.0" prefWidth="770.0" spacing="16.0" style="-fx-padding: 8 8 8 4;">
                    <children>
                        <Label fx:id="lblTitre"
                               text="Liste des Events"
                               style="-fx-text-fill: linear-gradient(to right, #d9d9d9, #ffffff);
                                      -fx-font-weight: bold;">
                            <font>
                                <Font name="System Bold" size="24.0"/>
                            </font>
                        </Label>

                        <HBox spacing="18.0"
                              style="-fx-background-color: rgba(15,15,17,0.52);
                                     -fx-background-radius: 18;
                                     -fx-border-color: #5e6268;
                                     -fx-border-radius: 18;
                                     -fx-padding: 14;">
                            <children>
                                <StackPane prefWidth="150.0" prefHeight="105.0"
                                           style="-fx-background-color: #101114;
                                                  -fx-background-radius: 16;
                                                  -fx-border-color: #6d7278;
                                                  -fx-border-radius: 16;
                                                  -fx-border-width: 1.1;">
                                    <children>
                                        <ImageView fx:id="localImagePreview"
                                                   fitWidth="140.0"
                                                   fitHeight="96.0"
                                                   preserveRatio="true"
                                                   managed="false"
                                                   visible="false" />
                                        <Label fx:id="imagePlaceholder"
                                               text="Aucune image locale"
                                               wrapText="true"
                                               style="-fx-text-fill: #8f9399; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                    </children>
                                </StackPane>

                                <VBox spacing="9.0">
                                    <children>
                                        <Label text="Local associe"
                                               style="-fx-text-fill: #f3f5f7; -fx-font-size: 16px; -fx-font-weight: bold;" />
                                        <Label fx:id="lblLocalMeta"
                                               text="Aucun local selectionne."
                                               wrapText="true"
                                               style="-fx-text-fill: #d7dce3; -fx-font-size: 13px;" />
                                        <Label fx:id="lblLocalStatus"
                                               text=""
                                               wrapText="true"
                                               style="-fx-text-fill: #d7dce3; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                        <Label text="Consultez et modifiez les events lies a ce local."
                                               wrapText="true"
                                               style="-fx-text-fill: #b8b8b8; -fx-font-size: 12px;" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox spacing="12.0" style="-fx-alignment: center-left;">
                            <children>
                                <TextField fx:id="txtSearch"
                                           promptText="Rechercher (titre, date, lieu, tickets...)"
                                           prefWidth="520.0"
                                           style="-fx-background-color: #151518;
                                                  -fx-text-fill: white;
                                                  -fx-prompt-text-fill: #8f8f8f;
                                                  -fx-border-color: #8f8f8f;
                                                  -fx-border-radius: 10;
                                                  -fx-background-radius: 10;" />

                                <ComboBox fx:id="cbSort"
                                          promptText="Trier par"
                                          prefWidth="210.0"
                                          style="-fx-background-color: #151518;
                                                 -fx-text-fill: white;
                                                 -fx-border-color: #8f8f8f;
                                                 -fx-border-radius: 10;
                                                 -fx-background-radius: 10;" />
                            </children>
                        </HBox>

                        <ListView fx:id="lvEvents"
                                  prefHeight="350.0"
                                  prefWidth="750.0"
                                  style="-fx-background-color: #151518;
                                         -fx-control-inner-background: #151518;
                                         -fx-background-insets: 0;
                                         -fx-background-radius: 18;
                                         -fx-border-color: #8f8f8f;
                                         -fx-border-radius: 18;
                                         -fx-border-width: 1;
                                         -fx-padding: 10;" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>
