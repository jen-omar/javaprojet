<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="760.0" prefWidth="980.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.mythoria.controller.FormEventController"
            style="-fx-background-color: linear-gradient(to bottom right, #0f0f10, #1c1c1f);">

    <children>
        <VBox layoutX="50.0" layoutY="24.0"
              prefWidth="880.0" prefHeight="700.0"
              spacing="18.0"
              style="-fx-background-color: linear-gradient(to bottom, #1f1f22, #2c2c31);
                     -fx-background-radius: 24;
                     -fx-border-color: #a8a8a8;
                     -fx-border-width: 1.2;
                     -fx-border-radius: 24;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 18, 0.2, 0, 6);
                     -fx-padding: 28;">

            <children>
                <Label fx:id="titleLabel"
                       text="Ajouter un Event"
                       style="-fx-text-fill: linear-gradient(to right, #d9d9d9, #ffffff);
                              -fx-font-weight: bold;">
                    <font>
                        <Font name="System Bold" size="24.0"/>
                    </font>
                </Label>

                <Label text="L'event reste lie au local selectionne et peut maintenant avoir sa propre image."
                       wrapText="true"
                       style="-fx-text-fill: #b8b8b8; -fx-font-size: 13px;" />

                <HBox spacing="24.0">
                    <children>
                        <VBox prefWidth="570.0" spacing="14.0">
                            <children>
                                <Label text="Titre"
                                       style="-fx-text-fill: #d0d0d0; -fx-font-weight: bold;" />
                                <TextField fx:id="tfTitle"
                                           promptText="Titre de l'evenement"
                                           style="-fx-background-color: #151518;
                                                  -fx-text-fill: white;
                                                  -fx-prompt-text-fill: #8e8e8e;
                                                  -fx-background-radius: 10;
                                                  -fx-border-color: #8f8f8f;
                                                  -fx-border-radius: 10;
                                                  -fx-border-width: 1;" />

                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Description"
                                               style="-fx-text-fill: #d0d0d0; -fx-font-weight: bold;"
                                               HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnImproveDescription"
                                                text="Ameliorer IA"
                                                onAction="#improveDescription"
                                                prefWidth="118.0"
                                                prefHeight="30.0"
                                                style="-fx-background-color: linear-gradient(to bottom, #c0c0c0, #8e8e8e);
                                                       -fx-text-fill: black;
                                                       -fx-font-size: 11px;
                                                       -fx-font-weight: bold;
                                                       -fx-background-radius: 9;
                                                       -fx-cursor: hand;" />
                                    </children>
                                </HBox>
                                <TextArea fx:id="taDescription"
                                          promptText="Description de l'evenement"
                                          prefHeight="100.0"
                                          wrapText="true"
                                          style="-fx-background-color: #151518;
                                                 -fx-control-inner-background: #151518;
                                                 -fx-text-fill: white;
                                                 -fx-prompt-text-fill: #8e8e8e;
                                                 -fx-background-radius: 10;
                                                 -fx-border-color: #8f8f8f;
                                                 -fx-border-radius: 10;
                                                 -fx-border-width: 1;" />

                                <Label text="Image de l'event"
                                       style="-fx-text-fill: #d0d0d0; -fx-font-weight: bold;" />
                                <HBox spacing="10.0">
                                    <children>
                                        <TextField fx:id="tfImage"
                                                   promptText="Chemin, URL ou ressource image"
                                                   style="-fx-background-color: #151518;
                                                          -fx-text-fill: white;
                                                          -fx-prompt-text-fill: #8e8e8e;
                                                          -fx-background-radius: 10;
                                                          -fx-border-color: #8f8f8f;
                                                          -fx-border-radius: 10;
                                                          -fx-border-width: 1;"
                                                   HBox.hgrow="ALWAYS" />
                                        <Button text="Parcourir"
                                                onAction="#chooseEventImage"
                                                prefWidth="120.0"
                                                style="-fx-background-color: linear-gradient(to bottom, #f3d6a2, #c99647);
                                                       -fx-text-fill: #1a1206;
                                                       -fx-font-weight: bold;
                                                       -fx-background-radius: 10;
                                                       -fx-cursor: hand;" />
                                        <Button fx:id="btnGenerateEventImage"
                                                text="Generer IA"
                                                onAction="#generateEventImage"
                                                prefWidth="120.0"
                                                style="-fx-background-color: linear-gradient(to bottom, #c0c0c0, #8e8e8e);
                                                       -fx-text-fill: black;
                                                       -fx-font-weight: bold;
                                                       -fx-background-radius: 10;
                                                       -fx-cursor: hand;" />
                                    </children>
                                </HBox>

                                <Label text="Date"
                                       style="-fx-text-fill: #d0d0d0; -fx-font-weight: bold;" />
                                <DatePicker fx:id="dpDate"
                                            prefWidth="570.0"
                                            style="-fx-background-color: #151518;
                                                   -fx-text-fill: white;
                                                   -fx-background-radius: 10;
                                                   -fx-border-color: #8f8f8f;
                                                   -fx-border-radius: 10;
                                                   -fx-border-width: 1;" />

                                <Label text="Lieu du local"
                                       style="-fx-text-fill: #d0d0d0; -fx-font-weight: bold;" />
                                <TextField fx:id="tfLocation"
                                           promptText="Genere depuis le local"
                                           editable="false"
                                           style="-fx-background-color: #151518;
                                                  -fx-text-fill: white;
                                                  -fx-prompt-text-fill: #8e8e8e;
                                                  -fx-background-radius: 10;
                                                  -fx-border-color: #8f8f8f;
                                                  -fx-border-radius: 10;
                                                  -fx-border-width: 1;" />

                                <HBox spacing="14.0">
                                    <children>
                                        <VBox prefWidth="180.0" spacing="10.0">
                                            <children>
                                                <Label text="Max tickets"
                                                       style="-fx-text-fill: #d0d0d0; -fx-font-weight: bold;" />
                                                <TextField fx:id="tfMaxTickets"
                                                           promptText="Total"
                                                           style="-fx-background-color: #151518;
                                                                  -fx-text-fill: white;
                                                                  -fx-prompt-text-fill: #8e8e8e;
                                                                  -fx-background-radius: 10;
                                                                  -fx-border-color: #8f8f8f;
                                                                  -fx-border-radius: 10;
                                                                  -fx-border-width: 1;" />
                                            </children>
                                        </VBox>

                                        <VBox prefWidth="180.0" spacing="10.0">
                                            <children>
                                                <Label text="Max VIP"
                                                       style="-fx-text-fill: #d0d0d0; -fx-font-weight: bold;" />
                                                <TextField fx:id="tfMaxVipTickets"
                                                           promptText="VIP"
                                                           style="-fx-background-color: #151518;
                                                                  -fx-text-fill: white;
                                                                  -fx-prompt-text-fill: #8e8e8e;
                                                                  -fx-background-radius: 10;
                                                                  -fx-border-color: #8f8f8f;
                                                                  -fx-border-radius: 10;
                                                                  -fx-border-width: 1;" />
                                            </children>
                                        </VBox>

                                        <VBox prefWidth="180.0" spacing="10.0">
                                            <children>
                                                <Label text="Max normaux"
                                                       style="-fx-text-fill: #d0d0d0; -fx-font-weight: bold;" />
                                                <TextField fx:id="tfMaxNormalTickets"
                                                           promptText="Normaux"
                                                           style="-fx-background-color: #151518;
                                                                  -fx-text-fill: white;
                                                                  -fx-prompt-text-fill: #8e8e8e;
                                                                  -fx-background-radius: 10;
                                                                  -fx-border-color: #8f8f8f;
                                                                  -fx-border-radius: 10;
                                                                  -fx-border-width: 1;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox prefWidth="250.0" spacing="12.0"
                              style="-fx-background-color: rgba(15,15,17,0.52);
                                     -fx-background-radius: 18;
                                     -fx-border-color: #5e6268;
                                     -fx-border-radius: 18;
                                     -fx-padding: 16;">
                            <children>
                                <Label text="Local lie"
                                       style="-fx-text-fill: #f3f5f7; -fx-font-size: 16px; -fx-font-weight: bold;" />
                                <Label fx:id="lblLocal"
                                       text="Aucun local selectionne"
                                       wrapText="true"
                                       style="-fx-text-fill: #f3f5f7; -fx-font-size: 14px; -fx-font-weight: bold;" />
                                <Label fx:id="lblLocalMeta"
                                       text="Selectionnez un local avant de creer un event."
                                       wrapText="true"
                                       style="-fx-text-fill: #b8b8b8; -fx-font-size: 12px;" />
                                <Label fx:id="lblLocalStatus"
                                       text=""
                                       wrapText="true"
                                       style="-fx-text-fill: #d7dce3; -fx-font-size: 12px; -fx-font-weight: bold;" />

                                <StackPane prefWidth="220.0" prefHeight="150.0"
                                           style="-fx-background-color: #101114;
                                                  -fx-background-radius: 16;
                                                  -fx-border-color: #6d7278;
                                                  -fx-border-radius: 16;
                                                  -fx-border-width: 1.1;">
                                    <children>
                                        <ImageView fx:id="localImagePreview"
                                                   fitWidth="210.0"
                                                   fitHeight="140.0"
                                                   preserveRatio="true"
                                                   managed="false"
                                                   visible="false" />
                                        <Label fx:id="imagePlaceholder"
                                               text="Aucune image locale"
                                               wrapText="true"
                                               style="-fx-text-fill: #8f9399; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                    </children>
                                </StackPane>

                                <Label text="Image de l'event"
                                       style="-fx-text-fill: #f3f5f7; -fx-font-size: 16px; -fx-font-weight: bold;" />
                                <StackPane prefWidth="220.0" prefHeight="170.0"
                                           style="-fx-background-color: #101114;
                                                  -fx-background-radius: 16;
                                                  -fx-border-color: #6d7278;
                                                  -fx-border-radius: 16;
                                                  -fx-border-width: 1.1;">
                                    <children>
                                        <ImageView fx:id="eventImagePreview"
                                                   fitWidth="210.0"
                                                   fitHeight="160.0"
                                                   preserveRatio="true"
                                                   managed="false"
                                                   visible="false" />
                                        <Label fx:id="eventImagePlaceholder"
                                               text="Aucune image d'event"
                                               wrapText="true"
                                               style="-fx-text-fill: #8f9399; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                    </children>
                                </StackPane>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="20.0" style="-fx-alignment: center; -fx-padding: 10 0 0 0;">
                    <children>
                        <Button fx:id="btnSave"
                                text="Enregistrer"
                                onAction="#saveEvent"
                                prefWidth="160.0"
                                prefHeight="42.0"
                                style="-fx-background-color: linear-gradient(to bottom, #c0c0c0, #8e8e8e);
                                       -fx-text-fill: black;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 12;
                                       -fx-cursor: hand;" />

                        <Button text="Retour"
                                onAction="#retourListe"
                                prefWidth="160.0"
                                prefHeight="42.0"
                                style="-fx-background-color: linear-gradient(to bottom, #4a4a4a, #2c2c2c);
                                       -fx-text-fill: #e6e6e6;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 12;
                                       -fx-cursor: hand;
                                       -fx-border-color: #9e9e9e;
                                       -fx-border-radius: 12;
                                       -fx-border-width: 1;" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
