<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="chatRoomContainer" prefHeight="800.0" prefWidth="1200.0" styleClass="app-root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.MessageController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="profile-bar">
            <children>
                <Button onAction="#onBack" styleClass="button" text="← Back to Dashboard" />
                <Label fx:id="chatTitle" styleClass="archives-title" text="Chambre des Contrats">
                    <font>
                        <Font name="Cinzel Bold" size="24.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnOpenPortal" mnemonicParsing="false" onAction="#onOpenPortal" text="SUMMON PORTAL" style="-fx-background-color: linear-gradient(to right, #111111, #2b2b2b); -fx-border-color: #D4AF37; -fx-text-fill: #D4AF37; -fx-border-radius: 8; -fx-border-width: 1; -fx-background-radius: 8; -fx-font-family: 'Cinzel', serif; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(212,175,55,0.6), 15, 0, 0, 0);" />
            </children>
        </HBox>
        <ScrollPane fx:id="messageScrollPane" fitToWidth="true" styleClass="archives-scroll" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="messageContainer" spacing="15.0" styleClass="archives-container">
                    <padding>
                        <Insets bottom="20.0" left="50.0" right="50.0" top="20.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>

        <!-- ═══ AI Toolbar — "The Forge" Arcane Buttons ═══ -->
        <HBox fx:id="aiToolbar" alignment="CENTER" spacing="16.0" styleClass="ai-toolbar">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
            </padding>
            <children>
                <Button fx:id="btnSummary" mnemonicParsing="false" onAction="#onAiSummary"
                        text="📜 Scroll of Summary" styleClass="ai-forge-btn, ai-forge-gold" />
                <Button fx:id="btnAutoReply" mnemonicParsing="false" onAction="#onAiAutoReply"
                        text="⚒ Forge Reply" styleClass="ai-forge-btn, ai-forge-ember" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="aiStatusLabel" text="" styleClass="ai-status-label" />
            </children>
        </HBox>

        <!-- ═══ Suggestion Chips Container (hidden by default) ═══ -->
        <HBox fx:id="suggestionContainer" alignment="CENTER" spacing="10.0" styleClass="ai-suggestion-bar" managed="false" visible="false">
            <padding>
                <Insets bottom="8.0" left="20.0" right="20.0" top="8.0" />
            </padding>
        </HBox>

        <!-- ═══ Message Input Bar ═══ -->
        <HBox spacing="15.0" style="-fx-background-color: #1a1a1a; -fx-padding: 20;">
            <children>
                <TextArea fx:id="messageInput" prefHeight="60.0" promptText="Enter your message..." style="-fx-control-inner-background: #222222; -fx-background-color: transparent; -fx-text-fill: #f0f0f0; -fx-prompt-text-fill: #888888; -fx-font-size: 15px; -fx-font-family: 'Segoe UI', sans-serif; -fx-border-color: #555555; -fx-border-radius: 10; -fx-background-radius: 10;" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnRecord" mnemonicParsing="false" onAction="#onToggleRecord" prefHeight="50.0" prefWidth="50.0" style="-fx-background-color: transparent; -fx-border-color: -mythoria-gold; -fx-border-radius: 50; -fx-background-radius: 50; -fx-text-fill: -mythoria-gold; -fx-font-size: 18;" text="🎤" />
                <Button mnemonicParsing="false" onAction="#onSendMessage" prefHeight="60.0" prefWidth="100.0" styleClass="create-button" text="SEND" />
            </children>
        </HBox>
    </children>
</VBox>
