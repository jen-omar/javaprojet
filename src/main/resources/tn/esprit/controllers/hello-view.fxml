<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="tn.esprit.controllers.GrandArchivesController" styleClass="app-root">
    <left>
        <VBox prefWidth="250" minWidth="250" maxWidth="250" BorderPane.alignment="CENTER" styleClass="sidebar">
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="sidebar-brand">
                <Label text="MYTHORIA" styleClass="sidebar-logo" />
            </HBox>

            <VBox fx:id="sidebarNav" spacing="6" styleClass="sidebar-nav">
                <Button text="HOME" onAction="#onNavigate" userData="HOME" styleClass="nav-button" maxWidth="Infinity">
                    <graphic>
                        <Label text="⌂" styleClass="nav-icon" />
                    </graphic>
                </Button>
                <Button fx:id="navArchives" text="GRAND ARCHIVES" onAction="#onNavigate" userData="ARCHIVES" styleClass="nav-button" maxWidth="Infinity">
                    <graphic>
                        <Label text="▦" styleClass="nav-icon" />
                    </graphic>
                </Button>
                <Button fx:id="navFellowship" text="FELLOWSHIP" onAction="#onNavigate" userData="FELLOWSHIP" styleClass="nav-button" maxWidth="Infinity">
                    <graphic>
                        <Label text="☉" styleClass="nav-icon" />
                    </graphic>
                </Button>
                <Button fx:id="navVenues" text="VENUES" onAction="#onNavigate" userData="VENUES" styleClass="nav-button" maxWidth="Infinity">
                    <graphic>
                        <Label text="⌬" styleClass="nav-icon" />
                    </graphic>
                </Button>
                <Button fx:id="navHappenings" text="HAPPENINGS" onAction="#onNavigate" userData="HAPPENINGS" styleClass="nav-button" maxWidth="Infinity">
                    <graphic>
                        <Label text="✦" styleClass="nav-icon" />
                    </graphic>
                </Button>
                <Button fx:id="navKinship" text="KINSHIP" onAction="#onNavigate" userData="KINSHIP" styleClass="nav-button" maxWidth="Infinity">
                    <graphic>
                        <Label text="⛉" styleClass="nav-icon" />
                    </graphic>
                </Button>
                <Button fx:id="navBazaar" text="THE BAZAAR" onAction="#onNavigate" userData="BAZAAR" styleClass="nav-button" maxWidth="Infinity">
                    <graphic>
                        <Label text="⟠" styleClass="nav-icon" />
                    </graphic>
                </Button>
                <Button fx:id="navUsers" text="USER MANAGEMENT" onAction="#onNavigate" userData="USERS" styleClass="nav-button" maxWidth="Infinity">
                    <graphic>
                        <Label text="⧉" styleClass="nav-icon" />
                    </graphic>
                </Button>
                <Button fx:id="navProfile" text="PROFILE" onAction="#onNavigate" userData="PROFILE" styleClass="nav-button" maxWidth="Infinity">
                    <graphic>
                        <Label text="⧉" styleClass="nav-icon" />
                    </graphic>
                </Button>
                <Button fx:id="navLogout" text="LOGOUT" onAction="#onNavigate" userData="LOGOUT" styleClass="nav-button" style="-fx-text-fill: #ff4c4c;" maxWidth="Infinity">
                    <graphic>
                        <Label text="✕" styleClass="nav-icon" />
                    </graphic>
                </Button>
            </VBox>


            <Region VBox.vgrow="ALWAYS" />

            <VBox spacing="6" styleClass="sidebar-footer">
                <Label fx:id="rankLabel" text="Rank: Journeyman" styleClass="footer-text" />
                <Label fx:id="pcLabel" text="100 PC" styleClass="footer-text" />
            </VBox>

            <padding>
                <Insets top="18" right="14" bottom="18" left="14" />
            </padding>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentStack" BorderPane.alignment="CENTER">
            <ScrollPane fx:id="archivesScroll" fitToWidth="true" pannable="true" styleClass="archives-scroll">
                <content>
                    <VBox spacing="12" styleClass="archives-container">
                        <HBox spacing="12" styleClass="archives-header">
                            <Label text="Grand Archives" styleClass="archives-title" />
                            <Region HBox.hgrow="ALWAYS" />
                        </HBox>

                        <FlowPane fx:id="worldGrid" styleClass="world-grid" prefWrapLength="1000" />
                    </VBox>
                </content>
            </ScrollPane>

            <StackPane fx:id="formHost" visible="false" managed="false">
                <padding>
                    <Insets top="26" right="26" bottom="26" left="26" />
                </padding>
            </StackPane>

            <Button fx:id="createButton" text="+" onAction="#onCreateWorld" styleClass="create-button" StackPane.alignment="BOTTOM_RIGHT" />
        </StackPane>
    </center>
</BorderPane>
