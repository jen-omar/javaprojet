<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="tn.esprit.controllers.OtpVerificationController" styleClass="login-root">
    <VBox alignment="CENTER_LEFT" maxWidth="460" spacing="16" styleClass="login-card">
        <Label text="MYTHORIA" styleClass="login-brand" />
        <Label text="Verification OTP" styleClass="login-title" wrapText="true" />
        <Label fx:id="instructionLabel" text="Code envoye par SMS." styleClass="login-subtitle" wrapText="true" />

        <VBox spacing="8">
            <Label text="Code OTP" styleClass="login-field-label" />
            <TextField fx:id="otpField" promptText="123456" onAction="#onVerifyOtp" />
        </VBox>

        <Button fx:id="verifyButton" text="Verifier" onAction="#onVerifyOtp" maxWidth="1.7976931348623157E308" styleClass="login-button" />

        <HBox spacing="10">
            <Button fx:id="resendButton" text="Renvoyer le code" onAction="#onResendOtp" />
            <Button text="Annuler" onAction="#onCancel" />
        </HBox>

        <Label fx:id="feedbackLabel" text="" wrapText="true" />

        <padding>
            <Insets top="28" right="28" bottom="28" left="28" />
        </padding>
    </VBox>
</StackPane>
